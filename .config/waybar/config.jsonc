{
  "layer": "top",
  "position": "top",
  "modules-left": ["hyprland/workspaces"],
  "modules-center": ["hyprland/window"],
  "modules-right": ["network", "pulseaudio", "battery", "clock"],
  "hyprland/window": { "max-length": 60 },
  "hyprland/workspaces": { "format": "{name}", "persistent-workspaces": { "*": 5 } },
  "network": { "format-wifi": "WIFI {signalStrength}%", "format-ethernet": "ETH", "format-disconnected": "OFF" },
  "pulseaudio": { "format": "VOL {volume}%", "format-muted": "MUTE" },
  "battery": { "format": "BAT {capacity}%", "format-charging": "CHG {capacity}%" },
  "clock": { "format": "{:%H:%M}", "format-alt": "{:%Y-%m-%d %H:%M}" }
}
